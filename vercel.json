{
  "version": 3,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "All-Environments",
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
  }
}
