{
  "name": "quran-data",
  "description": "مشروع Quran Data يوفر واجهة برمجة تطبيقات للوصول إلى بيانات القرآن الكريم وتنظيمها بشكل مرن وشامل",
  "version": "3.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "main": "server/server.mjs",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "echo 'Build completed successfully'",
    "start": "node server/server.mjs",
    "dev": "nodemon",
    "splitData": "node scripts/splitData.mjs",
    "jsonToSqlite": "node scripts/jsonToSqlite.mjs",
    "jsonToCsv": "node scripts/jsonToCsv.mjs",
    "addTimingToSqlite": "node scripts/addTimingToSqlite.mjs",
    "addApiReferenceToSqlite": "node scripts/addApiReferenceToSqlite.mjs",
    "addJsonToSqlite": "node scripts/addJsonToSqlite.mjs",
    "setup:db": "pnpm run jsonToSqlite && pnpm run addTimingToSqlite && pnpm run addApiReferenceToSqlite",
    "export:data": "pnpm run splitData && pnpm run jsonToCsv",
    "test:reciters": "node scripts/testReciterData.mjs"
  },
  "keywords": [],
  "author": {
    "name": "mohamed alromaihi",
    "email": "alromaihi2224@gmail.com",
    "url": "https://github.com/msr7799/quran-data"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "fs-extra": "^11.2.0",
    "node-fetch": "^3.3.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
